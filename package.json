{
  "name": "drizzle-http-driver",
  "version": "0.1.3",
  "description": "A transaction-capable PostgreSQL HTTP driver for Drizzle ORM",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgresql",
    "http",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baskinwind/drizzle-http-driver.git"
  },
  "homepage": "https://github.com/baskinwind/drizzle-http-driver#readme",
  "bugs": {
    "url": "https://github.com/baskinwind/drizzle-http-driver/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.2",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16"
  }
}
