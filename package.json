{
  "name": "drizzle-http-driver",
  "version": "0.2.0-rc.0",
  "description": "Transaction-capable PostgreSQL and MySQL HTTP drivers for Drizzle ORM, with an Oracle SQL adapter",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./postgresql": {
      "types": "./dist/postgresql.d.ts",
      "import": "./dist/postgresql.js",
      "require": "./dist/postgresql.cjs"
    },
    "./mysql": {
      "types": "./dist/mysql.d.ts",
      "import": "./dist/mysql.js",
      "require": "./dist/mysql.cjs"
    },
    "./oracle": {
      "types": "./dist/oracle.d.ts",
      "import": "./dist/oracle.js",
      "require": "./dist/oracle.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:remote": "tsx tests/run-remote.ts",
    "test:postgresql": "tsx tests/run-remote.ts postgresql",
    "test:mysql": "tsx tests/run-remote.ts mysql",
    "test:oracle": "tsx tests/run-remote.ts oracle",
    "test:exports": "node --test tests/package-exports.mjs && tsc -p tsconfig.exports.json --noEmit"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgresql",
    "http",
    "database",
    "mysql",
    "oracle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baskinwind/drizzle-http-driver.git"
  },
  "homepage": "https://github.com/baskinwind/drizzle-http-driver#readme",
  "bugs": {
    "url": "https://github.com/baskinwind/drizzle-http-driver/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.0.16"
  }
}
